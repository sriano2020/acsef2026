def predict_f1_hybrid(parent1_name, parent2_name):
    """Predict F1 hybrid phenotypes from two parent ecotypes"""
    
    if parent1_name not in arabidopsis_ecotypes:
        raise ValueError(f"Ecotype '{parent1_name}' not found in database")
    if parent2_name not in arabidopsis_ecotypes:
        raise ValueError(f"Ecotype '{parent2_name}' not found in database")
    
    p1 = arabidopsis_ecotypes[parent1_name]
    p2 = arabidopsis_ecotypes[parent2_name]
    
    predictions = {}
    
    for trait in traits:
        X_pred = pd.DataFrame({
            'p1_' + trait: [p1[trait]],
            'p2_' + trait: [p2[trait]]
        })
        predictions[trait] = models[trait].predict(X_pred)[0]
    
    return predictions

def describe_trait(trait_name, value):
    """Convert numeric value to descriptive text"""
    
    descriptions = {
        'flowering_time': {
            'low': 'very early flowering',
            'medium': 'medium flowering time',
            'high': 'late flowering'
        },
        'rosette_size': {
            'low': 'small rosette',
            'medium': 'medium rosette',
            'high': 'large rosette'
        },
        'root_length': {
            'low': 'short roots',
            'medium': 'medium root length',
            'high': 'long roots'
        },
        'trichome_density': {
            'low': 'low trichome density',
            'medium': 'medium trichome density',
            'high': 'high trichome density'
        },
        'stress_tolerance': {
            'low': 'low stress tolerance',
            'medium': 'medium stress tolerance',
            'high': 'high stress tolerance'
        },
        'seed_size': {
            'low': 'small seeds',
            'medium': 'medium seeds',
            'high': 'large seeds'
        },
        'growth_rate': {
            'low': 'slow growth',
            'medium': 'medium growth rate',
            'high': 'fast growth'
        }
    }
    
    if value < 3.5:
        category = 'low'
    elif value < 6.5:
        category = 'medium'
    else:
        category = 'high'
    
    return descriptions[trait_name][category]

def format_trait_name(trait):
    """Format trait name for display"""
    return trait.replace('_', ' ').title()

