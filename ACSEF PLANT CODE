print("Training machine learning models...")

# Create training data from all possible crosses
traits = ['flowering_time', 'rosette_size', 'root_length', 'trichome_density', 
          'stress_tolerance', 'seed_size', 'growth_rate']

training_data = []

# Generate training data from parent combinations
ecotype_names = list(arabidopsis_ecotypes.keys())

for i, p1_name in enumerate(ecotype_names):
    for j, p2_name in enumerate(ecotype_names):
        if i <= j:  # Avoid duplicates (A×B same as B×A)
            p1 = arabidopsis_ecotypes[p1_name]
            p2 = arabidopsis_ecotypes[p2_name]
            
            # Check if we have known F1 data
            if (p1_name, p2_name) in known_f1_crosses:
                f1_data = known_f1_crosses[(p1_name, p2_name)]
            elif (p2_name, p1_name) in known_f1_crosses:
                f1_data = known_f1_crosses[(p2_name, p1_name)]
            else:
                # Simulate F1 using inheritance patterns
                # HETEROSIS CALCULATION - This is the key part!
                
                f1_data = {}
                for trait in traits:
                    # Step 1: Calculate the mid-parent value (simple average)
                    # If Parent 1 = 4 and Parent 2 = 6, mid-parent = 5
                    base_avg = (p1[trait] + p2[trait]) / 2
                    
                    # Step 2: Calculate HETEROSIS (can be positive, negative, or near zero)
                    # Heterosis depends on:
                    #   - How different the parents are (genetic diversity)
                    #   - The specific trait (some traits show more heterosis)
                    #   - Random genetic interactions
                    
                    parent_difference = abs(p1[trait] - p2[trait])
                    
                    # Different traits show different heterosis patterns:
                    # - Fitness traits (growth, tolerance): Usually positive heterosis
                    # - Morphological traits (size, length): Often additive
                    # - Some traits: Can show negative heterosis
                    
                    if trait in ['growth_rate', 'stress_tolerance']:
                        # Fitness traits: Usually show POSITIVE heterosis (hybrid vigor)
                        # The more different the parents, the stronger the effect
                        heterosis_factor = 0.15 * parent_difference
                        # Add small random variation
                        heterosis = heterosis_factor + np.random.uniform(-0.1, 0.3)
                        
                    elif trait in ['flowering_time']:
                        # Flowering time: Can go either way
                        # Sometimes early (positive), sometimes late (negative)
                        heterosis = np.random.uniform(-0.3, 0.3) * parent_difference * 0.1
                        
                    elif trait in ['rosette_size', 'root_length', 'seed_size']:
                        # Size/morphology traits: Usually ADDITIVE (little heterosis)
                        # Small random variation around mid-parent
                        heterosis = np.random.uniform(-0.2, 0.4) * parent_difference * 0.1
                        
                    else:  # trichome_density and others
                        # Other traits: Mixed results
                        heterosis = np.random.uniform(-0.2, 0.3) * parent_difference * 0.1
                    
                    # Step 3: Add DOMINANCE effect (can be positive or negative)
                    # Sometimes high values are dominant, sometimes low values
                    # For most traits, higher is often (but not always) dominant
                    if trait in ['stress_tolerance', 'growth_rate']:
                        # Higher is usually better and dominant
                        dominance = 0.08 * max(p1[trait], p2[trait])
                    elif trait in ['flowering_time']:
                        # Early flowering (LOW values) often dominant
                        dominance = -0.05 * min(p1[trait], p2[trait])
                    else:
                        # Mixed dominance - can go either way
                        dominance = np.random.uniform(-0.05, 0.08) * max(p1[trait], p2[trait])
                    
                    # Step 4: Combine all effects
                    # Final F1 = Mid-parent + Heterosis + Dominance
                    # Clamp between 0 and 10
                    f1_value = base_avg + heterosis + dominance
                    f1_data[trait] = max(0, min(10, f1_value))
                    
                    # VISUAL EXAMPLES:
                    # 
                    # POSITIVE HETEROSIS (Growth Rate):
                    # Parent 1 = 4, Parent 2 = 6
                    # base_avg = 5.0
                    # heterosis = +0.4 (positive boost!)
                    # dominance = +0.5
                    # F1 = 5.0 + 0.4 + 0.5 = 5.9 (BETTER than 5.0!)
                    #
                    # ADDITIVE (Rosette Size):
                    # Parent 1 = 5, Parent 2 = 7
                    # base_avg = 6.0
                    # heterosis = +0.1 (small effect)
                    # dominance = +0.1
                    # F1 = 6.0 + 0.1 + 0.1 = 6.2 (close to mid-parent)
                    #
                    # NEGATIVE HETEROSIS (rare):
                    # Parent 1 = 3, Parent 2 = 8
                    # base_avg = 5.5
                    # heterosis = -0.3 (genes clash!)
                    # dominance = -0.2
                    # F1 = 5.5 - 0.3 - 0.2 = 5.0 (worse than mid-parent!)
            
            for trait in traits:
                training_data.append({
                    'p1_' + trait: p1[trait],
                    'p2_' + trait: p2[trait],
                    'offspring_' + trait: f1_data[trait],
                    'trait_name': trait
                })

df_train = pd.DataFrame(training_data)

# Train separate models for each trait
models = {}
print(f"Training dataset created with {len(df_train)} samples.\n")

for trait in traits:
    trait_data = df_train[df_train['trait_name'] == trait]
    X = trait_data[['p1_' + trait, 'p2_' + trait]]
    y = trait_data['offspring_' + trait]
    
    model = RandomForestRegressor(n_estimators=100, random_state=42)
    model.fit(X, y)
    models[trait] = model

print("Models trained successfully!\n")

